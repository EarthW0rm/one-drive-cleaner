{
  "name": "one-drive-cleaner-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "contract:types": "openapi-typescript src/api/openapi.json -o src/api/schema.gen.ts && node -e \"const fs=require('fs');const f='src/api/schema.gen.ts';fs.writeFileSync(f,'// SPDX-License-Identifier: GPL-3.0-only\\n'+fs.readFileSync(f,'utf8'))\"",
    "lint": "eslint . && prettier --check . && tsc --noEmit && knip",
    "lint:report": "eslint . --format json --output-file ../build/reports/eslint.json",
    "test": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^6.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "msw": "^3.0.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
