{
  "components": {
    "schemas": {
      "AccountInfo": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "AccountInfo",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION_ERROR",
          "PROTECTED_CATEGORY",
          "NOT_IN_QUARANTINE",
          "INVALID_CONFIRMATION",
          "LOGIN_REQUIRED",
          "CONFLICT",
          "NOT_FOUND",
          "INTERNAL"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "Envelope do erro padrão: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db",
            "type": "string"
          },
          "graph_auth": {
            "enum": [
              "ok",
              "login_required"
            ],
            "title": "Graph Auth",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "graph_auth"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "account": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccountInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "auth_state": {
            "enum": [
              "authenticated",
              "login_required"
            ],
            "title": "Auth State",
            "type": "string"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token",
          "auth_state",
          "account"
        ],
        "title": "SessionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OneDrive Cleaner API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/session": {
      "get": {
        "operationId": "get_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Token CSRF ausente ou inválido"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Recurso inexistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requisição inválida"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno"
          }
        },
        "summary": "Get Session",
        "tags": [
          "system"
        ]
      }
    },
