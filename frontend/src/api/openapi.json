{
  "components": {
    "schemas": {
      "AccountInfo": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "AccountInfo",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION_ERROR",
          "PROTECTED_CATEGORY",
          "NOT_IN_QUARANTINE",
          "INVALID_CONFIRMATION",
          "LOGIN_REQUIRED",
          "CONFLICT",
          "GRAPH_UNAVAILABLE",
          "NOT_FOUND",
          "INTERNAL"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "Envelope do erro padrão: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FolderModel": {
        "properties": {
          "child_count": {
            "title": "Child Count",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "child_count"
        ],
        "title": "FolderModel",
        "type": "object"
      },
      "FoldersResponse": {
        "properties": {
          "folders": {
            "items": {
              "$ref": "#/components/schemas/FolderModel"
            },
            "title": "Folders",
            "type": "array"
          }
        },
        "required": [
          "folders"
        ],
        "title": "FoldersResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db",
            "type": "string"
          },
          "graph_auth": {
            "enum": [
              "ok",
              "login_required"
            ],
            "title": "Graph Auth",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "graph_auth"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ScanRootModel": {
        "properties": {
          "display_path": {
            "title": "Display Path",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "display_path",
          "is_default"
        ],
        "title": "ScanRootModel",
        "type": "object"
      },
      "ScanRootsResponse": {
        "properties": {
          "scan_roots": {
            "items": {
              "$ref": "#/components/schemas/ScanRootModel"
            },
            "title": "Scan Roots",
            "type": "array"
          }
        },
        "required": [
          "scan_roots"
        ],
        "title": "ScanRootsResponse",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "account": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccountInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "auth_state": {
            "enum": [
              "authenticated",
              "login_required"
            ],
            "title": "Auth State",
            "type": "string"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token",
          "auth_state",
          "account"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SetScanRootsRequest": {
        "additionalProperties": false,
        "properties": {
          "folder_ids": {
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9!_.~-]+$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Folder Ids",
            "type": "array"
          }
        },
        "required": [
          "folder_ids"
        ],
        "title": "SetScanRootsRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OneDrive Cleaner API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/folders": {
      "get": {
        "operationId": "list_folders",
        "parameters": [
          {
            "in": "query",
            "name": "parent_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9!_.~-]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Parent Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoldersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Login necessário"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Token CSRF ausente ou inválido"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Recurso inexistente"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Requisição inválida"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Graph indisponível"
          }
        },
        "summary": "List Folders",
        "tags": [
          "folders"
        ]
      }
    },
