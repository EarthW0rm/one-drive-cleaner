{
  "components": {
    "schemas": {
      "AccountInfo": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          }
        },
        "required": [
          "display_name"
        ],
        "title": "AccountInfo",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "VALIDATION_ERROR",
          "PROTECTED_CATEGORY",
          "NOT_IN_QUARANTINE",
          "INVALID_CONFIRMATION",
          "LOGIN_REQUIRED",
          "CONFLICT",
          "GRAPH_UNAVAILABLE",
          "NOT_FOUND",
          "INTERNAL"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "Envelope do erro padrão: `{\"error\": {\"code\", \"message\", \"details\"}}`.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FailureModel": {
        "properties": {
          "failure_count": {
            "title": "Failure Count",
            "type": "integer"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "item_id": {
            "title": "Item Id",
            "type": "integer"
          }
        },
        "required": [
          "item_id",
          "failure_reason",
          "failure_count"
        ],
        "title": "FailureModel",
        "type": "object"
      },
      "FailuresResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FailureModel"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FailuresResponse",
        "type": "object"
      },
      "FolderModel": {
        "properties": {
          "child_count": {
            "title": "Child Count",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "child_count"
        ],
        "title": "FolderModel",
        "type": "object"
      },
      "FoldersResponse": {
        "properties": {
          "folders": {
            "items": {
              "$ref": "#/components/schemas/FolderModel"
            },
            "title": "Folders",
            "type": "array"
          }
        },
        "required": [
          "folders"
        ],
        "title": "FoldersResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db",
            "type": "string"
          },
          "graph_auth": {
            "enum": [
              "ok",
              "login_required"
            ],
            "title": "Graph Auth",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "graph_auth"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobModel": {
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "pause_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pause Reason"
          },
          "progress": {
            "$ref": "#/components/schemas/ProgressModel"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "progress",
          "pause_reason",
          "error_code"
        ],
        "title": "JobModel",
        "type": "object"
      },
      "JobType": {
        "enum": [
          "scan",
          "extract",
          "classify",
          "train",
          "auto_actions",
          "move",
          "restore",
          "delete",
          "reconcile",
          "cleanup"
        ],
        "title": "JobType",
        "type": "string"
      },
      "JobsResponse": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobModel"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "JobsResponse",
        "type": "object"
      },
      "ProgressModel": {
        "properties": {
          "done": {
            "title": "Done",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "done",
          "total"
        ],
        "title": "ProgressModel",
        "type": "object"
      },
      "RetryFailuresRequest": {
        "additionalProperties": false,
        "properties": {
          "item_ids": {
            "items": {
              "exclusiveMinimum": 0.0,
              "type": "integer"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Item Ids",
            "type": "array"
          }
        },
        "required": [
          "item_ids"
        ],
        "title": "RetryFailuresRequest",
        "type": "object"
      },
      "RetryFailuresResponse": {
        "properties": {
          "job_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Job Ids",
            "type": "array"
          },
          "requeued": {
            "title": "Requeued",
            "type": "integer"
          },
          "skipped": {
            "title": "Skipped",
            "type": "integer"
          }
        },
        "required": [
          "job_ids",
          "requeued",
          "skipped"
        ],
        "title": "RetryFailuresResponse",
        "type": "object"
      },
      "ScanAcceptedResponse": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "integer"
          }
        },
        "required": [
          "job_id"
        ],
        "title": "ScanAcceptedResponse",
        "type": "object"
      },
      "ScanRequest": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "auto",
              "full"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "ScanRequest",
        "type": "object"
      },
      "ScanRootModel": {
        "properties": {
          "display_path": {
            "title": "Display Path",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "display_path",
          "is_default"
        ],
        "title": "ScanRootModel",
        "type": "object"
      },
      "ScanRootsResponse": {
        "properties": {
          "scan_roots": {
            "items": {
              "$ref": "#/components/schemas/ScanRootModel"
            },
            "title": "Scan Roots",
            "type": "array"
          }
        },
        "required": [
          "scan_roots"
        ],
        "title": "ScanRootsResponse",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "account": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccountInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "auth_state": {
            "enum": [
              "authenticated",
              "login_required"
            ],
            "title": "Auth State",
            "type": "string"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token",
          "auth_state",
          "account"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SetScanRootsRequest": {
        "additionalProperties": false,
        "properties": {
          "folder_ids": {
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9!_.~-]+$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Folder Ids",
            "type": "array"
          }
        },
        "required": [
          "folder_ids"
        ],
        "title": "SetScanRootsRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OneDrive Cleaner API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/failures": {
      "get": {
        "operationId": "list_failures",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailuresResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Token CSRF ausente ou inválido"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Job inexistente"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Estado do job não permite a ação"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Cursor inválido"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Processamento indisponível"
          }
        },
        "summary": "List Failures",
        "tags": [
          "jobs"
        ]
      }
    },
